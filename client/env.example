# Backend API URL
# URL of the backend server (without /api)
VITE_API_URL=http://localhost:5000

# WebSocket URL
# URL for Socket.IO connections (usually same as API URL)
VITE_SOCKET_URL=http://localhost:5000

# Weather API (Optional)
# API key for weather service (e.g., OpenWeatherMap)
VITE_WEATHER_KEY=

# Default City Coordinates (Optional)
# Latitude and Longitude for default map location
VITE_CITY_LAT=41.55
VITE_CITY_LON=60.63

